@page "/"
@rendermode InteractiveServer
@inject IDocumentService DocumentService
@inject IBatchDocumentService BatchService
@inject IDocumentSearchService SearchService
@implements IDisposable

<PageTitle>Nebula Search — encontre qualquer coisa nos seus arquivos</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow"><span></span> Busca documental inteligente</p>
        <h1>Seus arquivos,<br /><em>finalmente encontráveis.</em></h1>
        <p class="hero-description">
            Envie PDFs, documentos ou textos. Nós cuidamos da extração,
            indexação e busca — em segundos.
        </p>
    </div>
    <div class="hero-orbit" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="core">
            <svg viewBox="0 0 48 48">
                <path d="m13 14 11-7 11 7v14l-11 7-11-7Z" />
                <circle cx="24" cy="21" r="6" />
                <path d="m28.5 25.5 6 6" />
            </svg>
        </div>
    </div>
</section>

<section class="workspace" aria-label="Área de documentos">
    <div class="panel upload-panel">
        <div class="panel-heading">
            <div>
                <p class="step-label">01 · Alimentar a busca</p>
                <h2>@(uploadMode == UploadMode.Single ? "Adicionar documento" : "Enviar pacote ZIP")</h2>
            </div>
            <span class="file-limit">até @(uploadMode == UploadMode.Single ? "25 MB" : "100 MB")</span>
        </div>

        <div class="upload-mode" role="group" aria-label="Modo de upload">
            <button type="button" class="@(uploadMode == UploadMode.Single ? "active" : null)"
                    @onclick="() => SetUploadMode(UploadMode.Single)">
                Arquivo único
            </button>
            <button type="button" class="@(uploadMode == UploadMode.Batch ? "active" : null)"
                    @onclick="() => SetUploadMode(UploadMode.Batch)">
                Pacote ZIP
                <span>novo</span>
            </button>
        </div>

        <label class="drop-zone @(selectedFile is not null ? "has-file" : null)">
            <InputFile @key="uploadMode" OnChange="SelectFile" accept="@AcceptedExtensions" />
            <span class="upload-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
                </svg>
            </span>
            @if (selectedFile is null)
            {
                <strong>@(uploadMode == UploadMode.Single ? "Escolha um arquivo" : "Escolha um pacote ZIP")</strong>
                <span>ou arraste para esta área</span>
                <small>@(uploadMode == UploadMode.Single ? "PDF, DOCX ou TXT" : "Até 100 documentos por lote")</small>
            }
            else
            {
                <strong>@selectedFile.Name</strong>
                <span>@FormatSize(selectedFile.Size)</span>
                <small>Clique para escolher outro</small>
            }
        </label>

        <button class="primary-button" type="button" @onclick="UploadAsync"
                disabled="@(selectedFile is null || isUploading)">
            @if (isUploading)
            {
                <span class="spinner" aria-hidden="true"></span>
                <span>@(uploadMode == UploadMode.Single ? "Enviando e indexando…" : "Descompactando e enviando…")</span>
            }
            else
            {
                <span>@(uploadMode == UploadMode.Single ? "Enviar para o Azure" : "Processar lote no Azure")</span>
                <span aria-hidden="true">↗</span>
            }
        </button>

        @if (documentStatus is not null)
        {
            <div class="notice @StatusClass(documentStatus.State)" role="status">
                <span class="notice-dot"></span>
                <div>
                    <strong>@StatusTitle(documentStatus.State)</strong>
                    <span>@StatusDescription(documentStatus.State)</span>
                </div>
            </div>
        }

        @if (batchStatus is not null)
        {
            <div class="batch-summary @BatchStatusClass(batchStatus.State)" role="status">
                <div class="batch-progress-heading">
                    <div>
                        <strong>@BatchStatusTitle(batchStatus.State)</strong>
                        <span>@batchStatus.Indexed de @batchStatus.Uploaded indexados</span>
                    </div>
                    <b>@BatchProgress(batchStatus)%</b>
                </div>
                <div class="progress-track">
                    <span style="width: @(BatchProgress(batchStatus))%"></span>
                </div>
                <div class="batch-counts">
                    <span><i class="ok"></i>@batchStatus.Uploaded enviados</span>
                    <span><i class="warn"></i>@batchStatus.Rejected rejeitados</span>
                    <span><i class="bad"></i>@batchStatus.Failed falharam</span>
                </div>
                <details>
                    <summary>Ver arquivos do lote</summary>
                    <div class="batch-items">
                        @foreach (var item in batchStatus.Items)
                        {
                            <div>
                                <span class="item-state @item.State.ToString().ToLowerInvariant()"></span>
                                <strong>@item.FileName</strong>
                                <small>@BatchItemLabel(item)</small>
                            </div>
                        }
                    </div>
                </details>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(uploadError))
        {
            <div class="notice error" role="alert">
                <span class="notice-dot"></span>
                <div>
                    <strong>Não foi possível enviar</strong>
                    <span>@uploadError</span>
                </div>
            </div>
        }
    </div>

    <div class="panel search-panel">
        <div class="panel-heading">
            <div>
                <p class="step-label">02 · Encontrar respostas</p>
                <h2>Pesquisar conteúdo</h2>
            </div>
            @if (searchResult is not null)
            {
                <span class="result-count">@searchResult.Total resultado(s)</span>
            }
        </div>

        <form class="search-box" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" />
                <path d="m16 16 4 4" />
            </svg>
            <input @bind="query" @bind:event="oninput"
                   placeholder="O que você quer encontrar?" aria-label="Termo de pesquisa" />
            <button type="submit" disabled="@(isSearching || string.IsNullOrWhiteSpace(query))">
                @if (isSearching)
                {
                    <span class="spinner dark" aria-hidden="true"></span>
                }
                else
                {
                    <span>Buscar</span>
                }
            </button>
        </form>

        <div class="search-content">
            @if (!string.IsNullOrWhiteSpace(searchError))
            {
                <div class="notice error" role="alert">
                    <span class="notice-dot"></span>
                    <div>
                        <strong>A busca não respondeu</strong>
                        <span>@searchError</span>
                    </div>
                </div>
            }
            else if (searchResult is null)
            {
                <div class="empty-results">
                    <span class="empty-glyph">⌕</span>
                    <strong>Pronto quando você estiver</strong>
                    <p>Pesquise uma palavra, frase ou assunto presente nos documentos enviados.</p>
                </div>
            }
            else if (searchResult.Items.Count == 0)
            {
                <div class="empty-results">
                    <span class="empty-glyph">0</span>
                    <strong>Nenhum resultado encontrado</strong>
                    <p>Tente termos mais amplos ou aguarde a indexação do último arquivo.</p>
                </div>
            }
            else
            {
                <div class="results-list">
                    @foreach (var item in searchResult.Items)
                    {
                        <article class="result-card">
                            <div class="file-badge">@FileExtension(item.FileName)</div>
                            <div class="result-body">
                                <div class="result-title-row">
                                    <h3>@item.FileName</h3>
                                    <span>@FormatScore(item.Score)</span>
                                </div>
                                @if (item.Highlights.Count > 0)
                                {
                                    <p class="highlight">@SafeHighlight(item.Highlights[0])</p>
                                }
                                <div class="metadata">
                                    <span>@(item.ContentType ?? "arquivo")</span>
                                    @if (item.Size is not null)
                                    {
                                        <span>@FormatSize(item.Size.Value)</span>
                                    }
                                    @if (item.LastModified is not null)
                                    {
                                        <span>@item.LastModified.Value.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="how-it-works">
    <p class="step-label">Por baixo do capô</p>
    <div class="flow">
        <div><span>1</span><strong>Upload seguro</strong><small>Blob privado</small></div>
        <i>→</i>
        <div><span>2</span><strong>Extração de texto</strong><small>Indexer do Azure</small></div>
        <i>→</i>
        <div><span>3</span><strong>Busca híbrida</strong><small>BM25 + vetores</small></div>
    </div>
</section>

@code {
    private const long MaximumFileSize = 25 * 1024 * 1024;
    private const long MaximumBatchSize = 100 * 1024 * 1024;
    private readonly CancellationTokenSource cancellation = new();
    private IBrowserFile? selectedFile;
    private DocumentStatus? documentStatus;
    private BatchStatus? batchStatus;
    private SearchPage? searchResult;
    private UploadMode uploadMode;
    private string query = string.Empty;
    private string? uploadError;
    private string? searchError;
    private bool isUploading;
    private bool isSearching;

    private long CurrentMaximumSize =>
        uploadMode == UploadMode.Single ? MaximumFileSize : MaximumBatchSize;

    private string AcceptedExtensions =>
        uploadMode == UploadMode.Single ? ".pdf,.docx,.txt" : ".zip";

    private void SetUploadMode(UploadMode mode)
    {
        uploadMode = mode;
        selectedFile = null;
        documentStatus = null;
        batchStatus = null;
        uploadError = null;
    }

    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        documentStatus = null;
        batchStatus = null;

        var expectedExtension = uploadMode == UploadMode.Single
            ? new[] { ".pdf", ".docx", ".txt" }
            : new[] { ".zip" };
        var extension = Path.GetExtension(selectedFile.Name);

        uploadError = !expectedExtension.Contains(extension, StringComparer.OrdinalIgnoreCase)
            ? uploadMode == UploadMode.Single
                ? "Escolha um arquivo PDF, DOCX ou TXT."
                : "Escolha um pacote com extensão ZIP."
            : selectedFile.Size > CurrentMaximumSize
                ? $"O arquivo ultrapassa o limite de {FormatSize(CurrentMaximumSize)}."
                : null;
    }

    private async Task UploadAsync()
    {
        if (selectedFile is null
            || selectedFile.Size > CurrentMaximumSize
            || !string.IsNullOrWhiteSpace(uploadError))
        {
            return;
        }

        isUploading = true;
        uploadError = null;
        documentStatus = null;
        batchStatus = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(CurrentMaximumSize, cancellation.Token);

            if (uploadMode == UploadMode.Batch)
            {
                var acceptedBatch = await BatchService.UploadBatchAsync(
                    new UploadBatch(stream, selectedFile.Name, selectedFile.Size),
                    "/api/batches/{batchId}/status",
                    cancellation.Token);

                batchStatus = await BatchService.GetBatchStatusAsync(
                    acceptedBatch.BatchId,
                    cancellation.Token);
                await PollBatchStatusAsync(acceptedBatch.BatchId);
                return;
            }

            var accepted = await DocumentService.UploadAsync(
                new UploadDocument(
                    stream,
                    selectedFile.Name,
                    selectedFile.ContentType,
                    selectedFile.Size),
                "/api/documents/{documentId}/status",
                cancellation.Token);

            documentStatus = new DocumentStatus(
                accepted.DocumentId,
                DocumentState.Pending,
                null,
                null);

            await PollStatusAsync(accepted.DocumentId);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            uploadError = exception.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task PollBatchStatusAsync(string batchId)
    {
        for (var attempt = 0; attempt < 45; attempt++)
        {
            batchStatus = await BatchService.GetBatchStatusAsync(batchId, cancellation.Token);

            if (batchStatus.State is not BatchState.Indexing and not BatchState.Uploading)
            {
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(2), cancellation.Token);
        }
    }

    private async Task PollStatusAsync(string documentId)
    {
        for (var attempt = 0; attempt < 30; attempt++)
        {
            documentStatus = await DocumentService.GetStatusAsync(documentId, cancellation.Token);

            if (documentStatus.State is not DocumentState.Pending)
            {
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(2), cancellation.Token);
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        isSearching = true;
        searchError = null;

        try
        {
            searchResult = await SearchService.SearchAsync(
                query,
                page: 1,
                pageSize: 20,
                cancellation.Token);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            searchError = exception.Message;
        }
        finally
        {
            isSearching = false;
        }
    }

    private static string StatusClass(DocumentState state) => state switch
    {
        DocumentState.Indexed => "success",
        DocumentState.Failed => "error",
        _ => "pending"
    };

    private static string StatusTitle(DocumentState state) => state switch
    {
        DocumentState.Indexed => "Documento indexado",
        DocumentState.Failed => "Falha na indexação",
        _ => "Indexação em andamento"
    };

    private static string StatusDescription(DocumentState state) => state switch
    {
        DocumentState.Indexed => "O conteúdo já está disponível para pesquisa.",
        DocumentState.Failed => "Confira o formato e tente enviar novamente.",
        _ => "O Azure está extraindo e organizando o texto."
    };

    private static string BatchStatusClass(BatchState state) => state switch
    {
        BatchState.Indexed => "success",
        BatchState.PartiallyFailed => "partial",
        BatchState.Failed => "error",
        _ => "pending"
    };

    private static string BatchStatusTitle(BatchState state) => state switch
    {
        BatchState.Indexed => "Lote totalmente indexado",
        BatchState.PartiallyFailed => "Lote concluído com ressalvas",
        BatchState.Failed => "Não foi possível concluir o lote",
        BatchState.Uploading => "Enviando documentos",
        _ => "Indexando o lote"
    };

    private static int BatchProgress(BatchStatus status) =>
        status.Uploaded == 0
            ? status.State == BatchState.Failed ? 100 : 0
            : (int)Math.Round(status.Indexed * 100d / status.Uploaded);

    private static string BatchItemLabel(BatchItemStatus item) => item.State switch
    {
        BatchItemState.Indexed => "Indexado",
        BatchItemState.Rejected => item.ErrorMessage ?? "Rejeitado",
        BatchItemState.Failed => item.ErrorMessage ?? "Falhou",
        _ => "Aguardando índice"
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576d:0.0} MB",
        >= 1_024 => $"{bytes / 1_024d:0.0} KB",
        _ => $"{bytes} B"
    };

    private static string FileExtension(string fileName)
    {
        var extension = Path.GetExtension(fileName).TrimStart('.');
        return string.IsNullOrWhiteSpace(extension) ? "DOC" : extension.ToUpperInvariant();
    }

    private static string FormatScore(double? score) =>
        score is null ? "relevante" : $"{score.Value:0.00} pts";

    private static MarkupString SafeHighlight(string highlight)
    {
        var safe = HtmlEncoder.Default.Encode(highlight)
            .Replace("&lt;em&gt;", "<mark>", StringComparison.OrdinalIgnoreCase)
            .Replace("&lt;/em&gt;", "</mark>", StringComparison.OrdinalIgnoreCase);
        return new MarkupString(safe);
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }

    private enum UploadMode
    {
        Single,
        Batch
    }
}
